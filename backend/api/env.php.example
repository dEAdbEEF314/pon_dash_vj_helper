<?php
// Configure these variables in the deployment environment before starting PHP.
// Generate HMAC_SECRET with: php -r "echo bin2hex(random_bytes(32));"
$PUSHER_APP_ID = getenv('PUSHER_APP_ID') ?: 'YOUR_PUSHER_APP_ID';
$PUSHER_KEY    = getenv('PUSHER_KEY') ?: 'YOUR_PUSHER_APP_KEY';
$PUSHER_SECRET = getenv('PUSHER_SECRET') ?: 'YOUR_PUSHER_SECRET';
$PUSHER_CLUSTER= getenv('PUSHER_CLUSTER') ?: 'ap3';
$HMAC_SECRET   = getenv('HMAC_SECRET') ?: 'CHANGE_THIS_DEFAULT_KEY';
$SESSION_LIFETIME = (int)(getenv('SESSION_LIFETIME') ?: 28800);
